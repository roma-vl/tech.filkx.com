APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=tech-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://tech-meilisearch:7700
MEILISEARCH_KEY=secret

FRONTEND_URL=http://localhost

# Google reCAPTCHA v3 - required for the login/register forms after repeated failed attempts
RECAPTCHA_SECRET_KEY=

# LiqPay merchant credentials (business.liqpay.ua) - card checkout is disabled until set
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

# Nova Poshta API key (developers.novaposhta.ua) - city/warehouse autocomplete falls back to
# plain free-text checkout fields until set
NOVA_POSHTA_API_KEY=

# Our own shipping-origin city's Nova Poshta ref ("CitySender", from Address/searchSettlements'
# DeliveryCity) - required in addition to the API key for delivery-date estimates; the product page
# falls back to a static delivery message until both are set. Leave blank until a real value is known.
NOVA_POSHTA_SENDER_CITY_REF=

# Sentry error tracking - sentry.io project or self-hosted GlitchTip; unset disables reporting.
# Use a separate project/DSN per environment (dev/staging/production) - don't reuse one project's
# DSN across environments, it mixes their events together.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.01
